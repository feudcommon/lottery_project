# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Telegram Bot
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# Database
DB_PATH=./data/lucky_loop.db

# Blockchain
RPC_URL=https://your-rpc-endpoint
BACKEND_PRIVATE_KEY=0xYOUR_PRIVATE_KEY
LLT_CONTRACT_ADDRESS=0xYourContractAddress
TREASURY_ADDRESS=0xYourTreasuryAddress

# Cron / timezone
CRON_TIMEZONE=UTC

# Frontend
FRONTEND_URL=https://your-frontend-url.com

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
COINS_PER_USD=100
STRIPE_MIN_AMOUNT_USD_CENTS=100
STRIPE_MAX_AMOUNT_USD_CENTS=50000

# Game economy
TICKET_PRICE=10
MAX_TICKETS_PER_USER_PER_DAY=2
TOTAL_TICKETS_PER_DAY=50
WINNER_REWARD=100
PLATFORM_FEE=100

# Sales window
SALES_OPEN_HOUR=9
SALES_CLOSE_HOUR=15
DRAW_HOUR=18

# Withdrawal rules
WITHDRAW_MIN_COINS=1000
WITHDRAW_MIN_REFERRALS=5
WITHDRAW_COIN_TO_TOKEN_RATE=100

# Admin
ADMIN_TELEGRAM_IDS=111111111,222222222